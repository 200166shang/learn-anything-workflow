{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-extract.local/schemas/delivery-operation-v1.schema.json",
  "title": "One-way delivery operation v1",
  "type": "object",
  "required": ["schema_version", "operation_id", "status", "intent", "suggestion_count", "content_digest", "attempt", "validation", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {"type": "string", "pattern": "^operation-delivery-[0-9a-f]{64}$"},
    "status": {"enum": ["busy", "completed", "recoverable_failure", "uncertain", "awaiting_user"]},
    "intent": {
      "type": "object",
      "required": ["workspace_id", "reminder_type", "date", "logical_target", "capability_id", "capability_contract_version", "engine_revision", "record_schema", "adapter", "adapter_identity", "authorization_ref", "related_identifiers", "suggestion_source_revisions", "effective_parameters_digest", "recipient_fingerprint", "host_fingerprint", "content_digest"],
      "properties": {
        "workspace_id": {"type": "string", "minLength": 1},
        "reminder_type": {"const": "daily_review"},
        "date": {"type": "string", "format": "date"},
        "logical_target": {"type": "string", "minLength": 1},
        "capability_id": {"const": "delivery.lark"},
        "capability_contract_version": {"const": 1},
        "engine_revision": {"type": "string", "minLength": 1},
        "record_schema": {"const": "delivery-operation-v1"},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_identity": {"type": "string", "minLength": 1},
        "authorization_ref": {"type": "string", "minLength": 1},
        "related_identifiers": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "suggestion_source_revisions": {"type": "object", "required": ["learning_commit_id", "card_commit_id", "review_commit_id"], "properties": {"learning_commit_id": {"type": "string"}, "card_commit_id": {"type": ["string", "null"]}, "review_commit_id": {"type": ["string", "null"]}}, "additionalProperties": false},
        "effective_parameters_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "recipient_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "host_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "suggestion_count": {"type": "integer", "minimum": 1, "maximum": 3},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt": {"type": "object", "required": ["idempotency_key", "query_handle", "submitted_at"], "properties": {"idempotency_key": {"type": "string", "minLength": 1, "maxLength": 50}, "query_handle": {"type": "string", "minLength": 1}, "submitted_at": {"type": "string"}}, "additionalProperties": false},
    "receipt": {"type": "object", "required": ["message_id", "sent_at", "target_fingerprint", "status"], "properties": {"message_id": {"type": "string", "minLength": 1}, "sent_at": {"type": "string", "minLength": 1}, "target_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "status": {"enum": ["sent", "reconciled"]}}, "additionalProperties": false},
    "reconciliation": {"type": "array", "items": {"type": "object"}},
    "history": {"type": "array", "items": {"type": "object", "required": ["final_status", "intent", "attempt", "reconciliation"], "properties": {"final_status": {"type": "string"}, "intent": {"type": "object"}, "attempt": {"type": "object"}, "reconciliation": {"type": "array"}}, "additionalProperties": false}},
    "validation": {"type": "object"},
    "diagnostics": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": ["object", "null"]},
    "artifact_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
