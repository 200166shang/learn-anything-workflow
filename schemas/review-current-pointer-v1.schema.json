{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-extract.local/schemas/review-current-pointer-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "commit_id", "manifest_sha256"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "commit_id": {"type": "string", "pattern": "^review-commit-[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
