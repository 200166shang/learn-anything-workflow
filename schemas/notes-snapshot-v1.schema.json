{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://video-extract.local/schemas/notes-snapshot-v1.schema.json","type":"object",
  "required":["schema_version","workspace_id","commit_id","parent_commit_id","revision","created_at","notes","objects"],
  "properties":{"schema_version":{"const":1},"workspace_id":{"type":"string","minLength":1},"commit_id":{"type":"string","pattern":"^note-commit-[0-9a-f]{64}$"},"parent_commit_id":{"type":["string","null"],"pattern":"^note-commit-[0-9a-f]{64}$"},"revision":{"type":"integer","minimum":1},"created_at":{"type":"string","format":"date-time"},"notes":{"type":"object","propertyNames":{"pattern":"^source-[0-9a-f-]{36}$"},"additionalProperties":{"$ref":"#/$defs/note"}},"objects":{"type":"object","propertyNames":{"pattern":"^[0-9a-f]{64}$"},"additionalProperties":{"$ref":"#/$defs/object"}}},
  "$defs":{
