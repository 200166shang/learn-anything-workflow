    "history":{"type":"object","required":["revision","source_version","created_at","body_object","citations_object","corrections_object","attachment_objects","association"],"properties":{"revision":{"type":"integer","minimum":1},"source_version":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"body_object":{"type":"string","pattern":"^[0-9a-f]{64}$"},"citations_object":{"type":"string","pattern":"^[0-9a-f]{64}$"},"corrections_object":{"type":"string","pattern":"^[0-9a-f]{64}$"},"attachment_objects":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"association":{"$ref":"#/$defs/association"},"visual_review":{"$ref":"#/$defs/visualReview"}},"additionalProperties":false},
    "note":{"type":"object","required":["source_id","source_version","revision","body_object","citations_object","corrections_object","attachment_objects","association","history"],"properties":{"source_id":{"type":"string"},"source_version":{"type":"string"},"revision":{"type":"integer","minimum":1},"body_object":{"type":"string"},"citations_object":{"type":"string"},"corrections_object":{"type":"string"},"attachment_objects":{"type":"array","items":{"type":"string"}},"association":{"$ref":"#/$defs/association"},"history":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/history"}},"visual_review":{"$ref":"#/$defs/visualReview"}},"additionalProperties":false},
    "pointer":{"type":"object","required":["schema_version","workspace_id","commit_id","manifest_sha256"],"properties":{"schema_version":{"const":1},"workspace_id":{"type":"string","minLength":1},"commit_id":{"type":"string","pattern":"^note-commit-[0-9a-f]{64}$"},"manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":false},
    "citation":{"type":"object","required":["claim","locator","locator_type"],"properties":{"claim":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},"locator_type":{"enum":["timestamp","paragraph","heading"]}},"additionalProperties":false},
    "finalizeRequest":{"type":"object","required":["schema_version","source_id","source_version","expected_revision","markdown","citations","corrections","attachments","association"],"properties":{"schema_version":{"const":1},"source_id":{"type":"string"},"source_version":{"type":"string"},"expected_revision":{"type":"integer","minimum":0},"markdown":{"type":"string","minLength":1},"citations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/citation"}},"corrections":{"type":"array","items":{"type":"object"}},"attachments":{"type":"array","items":{"type":"string"}},"association":{"$ref":"#/$defs/association"},"visual_review":{"$ref":"#/$defs/visualReview"}},"additionalProperties":false},
