{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://video-extract.local/schemas/learning-record-v2.schema.json","title":"Learning record v2","type":"object",
  "required":["schema_version","modules","threads","questions","relationships","feedbacks","preparations","explanations"],
  "properties":{"schema_version":{"const":2},"modules":{"type":"object","propertyNames":{"$ref":"#/$defs/moduleId"},"additionalProperties":{"$ref":"#/$defs/module"}},"threads":{"type":"object","propertyNames":{"$ref":"#/$defs/threadId"},"additionalProperties":{"$ref":"#/$defs/thread"}},"questions":{"type":"object","propertyNames":{"$ref":"#/$defs/questionId"},"additionalProperties":{"$ref":"#/$defs/question"}},"relationships":{"type":"object","propertyNames":{"$ref":"#/$defs/relationshipId"},"additionalProperties":{"$ref":"#/$defs/relationship"}},"feedbacks":{"type":"object","propertyNames":{"$ref":"#/$defs/feedbackId"},"additionalProperties":{"$ref":"#/$defs/feedback"}},"preparations":{"type":"object","propertyNames":{"$ref":"#/$defs/preparationId"},"additionalProperties":{"$ref":"#/$defs/preparation"}},"explanations":{"type":"object","propertyNames":{"$ref":"#/$defs/explanationId"},"additionalProperties":{"$ref":"#/$defs/explanation"}}},
  "$defs":{
    "moduleId":{"type":"string","pattern":"^module-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"threadId":{"type":"string","pattern":"^thread-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"questionId":{"type":"string","pattern":"^question-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"relationshipId":{"type":"string","pattern":"^relationship-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"feedbackId":{"type":"string","pattern":"^feedback-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"preparationId":{"type":"string","pattern":"^preparation-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"explanationId":{"type":"string","pattern":"^explanation-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"sectionId":{"type":"string","pattern":"^section-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sourceId":{"type":"string","pattern":"^source-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"sourceVersion":{"type":"string","pattern":"^source-version-[0-9a-f]{64}$"},
    "sourceRef":{"type":"object","required":["source_id","source_version","role"],"properties":{"source_id":{"$ref":"#/$defs/sourceId"},"source_version":{"$ref":"#/$defs/sourceVersion"},"role":{"enum":["course_fact","current_code","supplemental_source"]}},"additionalProperties":false},
    "module":{"type":"object","required":["module_id","goal","scope","source_refs","thread_ids","last_active_thread_id","created_at"],"properties":{"module_id":{"$ref":"#/$defs/moduleId"},"goal":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sourceRef"}},"thread_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/threadId"}},"last_active_thread_id":{"anyOf":[{"$ref":"#/$defs/threadId"},{"type":"null"}]},"created_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "navigationFrame":{"type":"object","required":["module_id","thread_id","question_id","entered_at"],"properties":{"module_id":{"$ref":"#/$defs/moduleId"},"thread_id":{"$ref":"#/$defs/threadId"},"question_id":{"$ref":"#/$defs/questionId"},"entered_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "entry":{"type":"object","required":["entry_id","from_question_id","to_question_id","relation","created_at"],"properties":{"entry_id":{"type":"string","pattern":"^entry-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"from_question_id":{"$ref":"#/$defs/questionId"},"to_question_id":{"$ref":"#/$defs/questionId"},"original_text":{"type":"string","minLength":1},"relation":{"enum":["deepens","applies","related","reference"]},"created_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "thread":{"type":"object","required":["thread_id","module_id","root_question_id","current_question_id","revision","created_at"],"properties":{"thread_id":{"$ref":"#/$defs/threadId"},"module_id":{"$ref":"#/$defs/moduleId"},"root_question_id":{"$ref":"#/$defs/questionId"},"current_question_id":{"$ref":"#/$defs/questionId"},"revision":{"type":"integer","minimum":1},"created_at":{"type":"string","format":"date-time"},"return_route":{"type":"array","items":{"$ref":"#/$defs/navigationFrame"}},"entry_history":{"type":"array","items":{"$ref":"#/$defs/entry"}}},"additionalProperties":false},
    "explanationRef":{"type":"object","required":["explanation_id","explanation_revision","section_id","object_sha256","logical_path"],"properties":{"explanation_id":{"$ref":"#/$defs/explanationId"},"explanation_revision":{"type":"integer","minimum":1},"section_id":{"$ref":"#/$defs/sectionId"},"object_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"logical_path":{"type":"string","pattern":"^learning/objects/[0-9a-f]{2}/[0-9a-f]{64}$"}},"additionalProperties":false},
    "question":{"type":"object","required":["question_id","thread_id","original_question","title","created_at","unresolved_confusions","explanation_refs"],"properties":{"question_id":{"$ref":"#/$defs/questionId"},"thread_id":{"$ref":"#/$defs/threadId"},"original_question":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"unresolved_confusions":{"type":"array","items":{"type":"string","minLength":1}},"explanation_refs":{"type":"array","items":{"$ref":"#/$defs/explanationRef"}}},"additionalProperties":false},
    "relationship":{"type":"object","required":["relationship_id","thread_id","from_question_id","to_question_id","type","created_at"],"properties":{"relationship_id":{"$ref":"#/$defs/relationshipId"},"thread_id":{"$ref":"#/$defs/threadId"},"from_question_id":{"$ref":"#/$defs/questionId"},"to_question_id":{"$ref":"#/$defs/questionId"},"type":{"enum":["deepens","applies","related","reference"]},"created_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "feedback":{"type":"object","required":["feedback_id","question_id","state","original_text","created_at"],"properties":{"feedback_id":{"$ref":"#/$defs/feedbackId"},"question_id":{"$ref":"#/$defs/questionId"},"state":{"enum":["understood","confused","parked"]},"original_text":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "preparation":{"type":"object","required":["preparation_id","question_id","profile","section_id","prepared_revision","source_refs","source_scope_sha256","created_at","consumed_at"],"properties":{"preparation_id":{"$ref":"#/$defs/preparationId"},"question_id":{"$ref":"#/$defs/questionId"},"profile":{"enum":["linear_transform","recognition_to_action","frame_pipeline"]},"section_id":{"$ref":"#/$defs/sectionId"},"prepared_revision":{"type":"integer","minimum":1},"source_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sourceRef"}},"source_scope_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"created_at":{"type":"string","format":"date-time"},"consumed_at":{"type":["string","null"],"format":"date-time"}},"additionalProperties":false},
    "locator":{"type":"object","required":["kind","value"],"properties":{"kind":{"enum":["heading","paragraph","symbol","line_range","time_range"]},"value":{"type":"string","minLength":1},"content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":false},
    "evidence":{"type":"object","required":["source_id","source_version","locator","claim_type","claim"],"properties":{"source_id":{"$ref":"#/$defs/sourceId"},"source_version":{"$ref":"#/$defs/sourceVersion"},"locator":{"$ref":"#/$defs/locator"},"claim_type":{"enum":["course_fact","current_code","supplemental_source","inference"]},"claim":{"type":"string","minLength":1}},"additionalProperties":false},
    "teachingReview":{"type":"object","required":["intuition","causality","mechanism","worked_example","conditions","source_alignment"],"properties":{"intuition":{"const":true},"causality":{"const":true},"mechanism":{"const":true},"worked_example":{"const":true},"conditions":{"const":true},"source_alignment":{"const":true},"basis_coordinate_reasoning":{"type":"boolean"},"affine_boundary":{"type":"boolean"},"actual_code_separated":{"type":"boolean"},"stale_input_handling":{"type":"boolean"},"actual_entry_verified":{"type":"boolean"},"concurrency_verified":{"type":"boolean"},"backpressure_shutdown":{"type":"boolean"}},"additionalProperties":false},
    "correction":{"type":"object","required":["correction_id","original_claim","corrected_claim","evidence_refs","affected_conclusions","confirmed_at","introduced_revision"],"properties":{"correction_id":{"type":"string","pattern":"^correction-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"original_claim":{"type":"string","minLength":1},"corrected_claim":{"type":"string","minLength":1},"applicability":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}},"affected_conclusions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"confirmed_at":{"type":"string","format":"date-time"},"introduced_revision":{"type":"integer","minimum":1}},"additionalProperties":false},
    "revision":{"type":"object","required":["revision","object_sha256","logical_path","created_at","profile","evidence_refs","teaching_review","section_map","change_reason"],"properties":{"revision":{"type":"integer","minimum":1},"object_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"logical_path":{"type":"string","pattern":"^learning/objects/[0-9a-f]{2}/[0-9a-f]{64}$"},"created_at":{"type":"string","format":"date-time"},"profile":{"enum":["linear_transform","recognition_to_action","frame_pipeline"]},"evidence_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}},"teaching_review":{"$ref":"#/$defs/teachingReview"},"section_map":{"type":"object","propertyNames":{"$ref":"#/$defs/questionId"},"additionalProperties":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sectionId"}}},"change_reason":{"enum":["initial","revised"]},"revision_kind":{"enum":["initial","revision","refactor","correction","restore"]},"change_summary":{"type":"string","minLength":1},"affected_question_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/questionId"}},"introduced_correction_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^correction-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}},"restored_from_revision":{"type":"integer","minimum":1}},"additionalProperties":false},
    "explanation":{"type":"object","required":["explanation_id","root_question_id","current_revision","revisions"],"properties":{"explanation_id":{"$ref":"#/$defs/explanationId"},"root_question_id":{"$ref":"#/$defs/questionId"},"current_revision":{"type":"integer","minimum":1},"revisions":{"type":"object","propertyNames":{"pattern":"^[1-9][0-9]*$"},"additionalProperties":{"$ref":"#/$defs/revision"}},"confirmed_corrections":{"type":"array","items":{"$ref":"#/$defs/correction"}}},"additionalProperties":false}
  },"additionalProperties":false
}
